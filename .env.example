# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed.

# Local PostgreSQL (used by docker-compose.yml)
DB_USER=cs2holdem
DB_PASSWORD=change-me
DB_NAME=cs2holdem_db
DB_PORT=5433

# Steam Web API key - https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your-steam-web-api-key

# 32 random bytes, base64. Encrypts players' Steam auth codes in the database.
# Create one with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Shared secret between the server and the demo worker (worker/). Long and random.
# Create one with: openssl rand -hex 32
WORKER_TOKEN=

# Where the app is reached from outside. Steam sends the browser back here after login.
PUBLIC_BASE_URL=http://localhost:8080

# true = /auth/dev-login?steamId64=... logs in without Steam. Local development only!
DEV_LOGIN=true

# false = turn off the scheduled Steam sync
SYNC_ENABLED=true

# Demo locator: a separate Steam account (a "bot", NEVER your own) that asks CS2's
# Game Coordinator where each match's demo is. The account must have CS2 in its library.
# The first start asks for a Steam Guard code in the console; after that a token in
# data/steam-bot/ is used instead of the password.
LOCATOR_ENABLED=false
STEAM_BOT_USERNAME=
STEAM_BOT_PASSWORD=
